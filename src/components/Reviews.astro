---
import { reviews, reviewsVerified, business } from '../config/business.js';
import Icon from './Icon.astro';
import Stars from './Stars.astro';

const { rating } = business;
---

<section id="avis" class="scroll-mt-20 border-t border-ink-800 py-section">
  <div class="mx-auto max-w-6xl px-5 lg:px-8">
    <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-xl">
        <p class="eyebrow" data-reveal>Avis clients</p>
        <h2
          class="mt-4 font-display text-[clamp(2rem,5.5vw,3.5rem)] font-bold uppercase leading-[1.02] tracking-[-0.015em] text-white"
          data-reveal
        >
          251 avis, et une moyenne qui tient
        </h2>
      </div>

      <div
        class="flex shrink-0 items-center gap-5 rounded-2xl border border-ink-700 bg-ink-900 px-7 py-5"
        data-reveal
      >
        <div>
          <p class="font-display text-5xl font-bold leading-none text-white">
            {rating.value.toString().replace('.', ',')}
          </p>
          <p class="mt-1 font-display text-sm uppercase tracking-wider text-chrome-400">sur 5</p>
        </div>
        <div class="h-12 w-px bg-ink-700"></div>
        <div>
          <Stars value={rating.value} size="size-4" />
          <p class="mt-2 text-sm text-chrome-300">
            <span class="font-semibold text-chrome-100">{rating.count} avis</span> Google
          </p>
        </div>
      </div>
    </div>

    {!reviewsVerified && (
      <p
        class="mt-10 flex items-start gap-3 rounded-xl border border-amber-500/40 bg-amber-500/10 px-5 py-4 text-sm leading-relaxed text-amber-200"
        data-placeholder-warning
      >
        <span aria-hidden="true" class="mt-0.5 text-base">⚠</span>
        <span>
          <strong class="font-semibold">Contenu de démonstration.</strong> Les textes d'avis
          ci-dessous sont des gabarits de mise en page, pas de vrais avis. Ils doivent être
          remplacés par le libellé exact des avis Google avant mise en ligne — publier de faux
          avis est sanctionné (art. L121-2 du Code de la consommation). Ce bandeau disparaît
          dès que <code class="rounded bg-ink-800 px-1.5 py-0.5 text-xs">reviewsVerified</code>
          passe à <code class="rounded bg-ink-800 px-1.5 py-0.5 text-xs">true</code>.
        </span>
      </p>
    )}

    {/*
      Scroll-snap carousel on mobile, plain grid from md up. No JS: a horizontal
      snap row is native, and this section must not cost the visitor a bundle.
    */}
    <ul
      class="mt-10 flex snap-x snap-mandatory gap-5 overflow-x-auto pb-4 [scrollbar-width:none] md:grid md:grid-cols-2 md:overflow-visible md:pb-0 lg:mt-14 lg:grid-cols-4 [&::-webkit-scrollbar]:hidden"
    >
      {reviews.map((review) => (
        <li
          class="flex w-[85vw] shrink-0 snap-start flex-col rounded-2xl border border-ink-700 bg-ink-900 p-7 sm:w-[60vw] md:w-auto"
          data-reveal
        >
          <Icon name="quote" class="size-7 text-ink-600" />
          <p class="mt-4 flex-1 leading-relaxed text-chrome-100">{review.text}</p>
          <div class="mt-6 border-t border-ink-700 pt-5">
            <Stars value={review.rating} size="size-3.5" />
            <p class="mt-2.5 font-display text-base font-semibold uppercase tracking-wide text-white">
              {review.author}
            </p>
            <p class="mt-0.5 text-xs uppercase tracking-[0.12em] text-chrome-400">
              {review.highlight}
            </p>
          </div>
        </li>
      ))}
    </ul>

    <p class="mt-4 text-sm text-chrome-400 md:hidden" aria-hidden="true">Faites défiler pour voir les autres avis →</p>
  </div>
</section>
