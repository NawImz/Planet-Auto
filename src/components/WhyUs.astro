---
import { Image } from 'astro:assets';
import { benefits } from '../config/business.js';
import boutique from '../assets/boutique-interieur.jpeg';
---

{/*
  No 01/02/03 markers here: these four points are not a sequence, and numbering
  them would dress up the content rather than describe it. Plain blocks on
  hairlines, which is what they are.
*/}
<section id="atouts" class="scroll-mt-20 border-t border-rule bg-paper py-section">
  <div class="mx-auto max-w-6xl px-5 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.25fr)] lg:gap-16">
      <div>
        <span class="band" data-reveal></span>
        <h2 class="mt-5 font-display text-[clamp(1.9rem,4.5vw,2.9rem)] font-extrabold" data-reveal>
          Ce qui revient<br />dans les avis
        </h2>
        <p class="mt-4 text-lg text-steel" data-reveal>
          Quatre choses que nos clients citent le plus souvent. Ce sont leurs
          mots, repris de la fiche Google — pas un argumentaire.
        </p>

        <div class="relative mt-10 overflow-hidden" data-reveal data-parallax>
          <Image
            src={boutique}
            alt="Le rayon outillage du magasin : clés, tournevis et coffrets sur panneau perforé, et derrière la porte les casiers de pièces détachées"
            widths={[400, 640, 768]}
            sizes="(min-width: 1024px) 420px, 100vw"
            loading="lazy"
            class="aspect-[4/5] w-full object-cover object-center lg:aspect-[3/4]"
          />
          <span class="absolute inset-x-0 bottom-0 h-1.5 bg-crimson" aria-hidden="true"></span>
        </div>
      </div>

      <div class="lg:pt-3">
        <dl class="border-t border-rule" data-stagger>
          {benefits.map((benefit) => (
            <div class="border-b border-rule py-7" data-reveal>
              <dt class="font-display text-[1.4rem] font-bold leading-snug">{benefit.title}</dt>
              <dd class="mt-2.5 text-steel">{benefit.description}</dd>
              {/* Named so the claim stays attached to whoever actually made it. */}
              <dd class="mt-2 text-[0.82rem] font-semibold uppercase tracking-[0.12em] text-steel-light">
                Cité par {benefit.source}
              </dd>
            </div>
          ))}
        </dl>

        {/* La bande de deux « faits pratiques » qui fermait cette colonne
            portait les moyens de paiement et l'entrée de plain-pied. Les deux
            sont retirés du site, et rien ne les remplace : la colonne se
            termine sur les avis, ce qui est le sujet de la section. */}
      </div>
    </div>
  </div>
</section>
