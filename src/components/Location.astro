---
import { Image } from 'astro:assets';
import { business } from '../config/business.js';
import { formatRanges } from '../lib/hours.js';
import rue from '../assets/rue-acces.jpeg';
import Icon from './Icon.astro';

const { address, hours } = business;

const fullAddress = `${address.street}, ${address.postalCode} ${address.city}`;

/*
  Google Maps, at the client's request — it shows the business card, the photos
  and the reviews inside the frame, which OpenStreetMap cannot.

  The embed is addressed by name and address rather than by coordinates, so it
  resolves the actual listing instead of dropping an anonymous pin. The stored
  coordinates still feed the geo field of the structured data.

  It loads only once the visitor has accepted: Google sets cookies the instant
  the iframe enters the document. See CookieConsent.astro.
*/
const query = encodeURIComponent(`${business.name}, ${fullAddress}`);
const googleMaps = `https://www.google.com/maps/search/?api=1&query=${query}`;
const waze = `https://waze.com/ul?q=${query}`;

const mapEmbed = `https://maps.google.com/maps?q=${query}&z=16&hl=fr&output=embed`;
---

<section id="acces" class="scroll-mt-20 border-t border-rule bg-paper py-section">
  <div class="mx-auto max-w-6xl px-5 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <span class="band" data-reveal></span>
        <h2 class="mt-5 font-display text-[clamp(1.9rem,4.5vw,2.9rem)] font-extrabold" data-reveal>
          Venir nous voir
        </h2>

        <address class="mt-6 not-italic text-xl leading-relaxed text-ink" data-reveal>
          {address.street}<br />
          {address.postalCode} {address.city}
        </address>
        <p class="mt-2 text-steel" data-reveal>
          Sur l'avenue, avec du stationnement devant l'atelier.
        </p>

        <div class="mt-6 flex flex-wrap gap-3" data-reveal>
          <a
            href={googleMaps}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 bg-crimson px-6 py-3.5 font-display font-bold text-white transition-colors hover:bg-crimson-deep"
          >
            <Icon name="pin" class="size-4" />
            Itinéraire
          </a>
          <a
            href={waze}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 border border-rule-strong px-6 py-3.5 font-display font-semibold text-ink transition-colors hover:border-ink"
          >
            Waze
          </a>
        </div>

        <h3 class="label mt-12 border-t border-rule pt-8 text-ink" data-reveal>Horaires</h3>
        <dl class="mt-4" data-reveal>
          {hours.map((day) => (
            <div class="flex items-baseline justify-between gap-4 border-b border-rule py-2.5">
              <dt class="font-semibold text-ink">{day.day}</dt>
              <dd
                class:list={[
                  'text-right tabular-nums',
                  day.ranges.length ? 'text-ink-soft' : 'text-steel-light',
                ]}
              >
                {formatRanges(day.ranges)}
              </dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="flex flex-col gap-6">
        <div data-reveal>
          {/* The address sits behind the frame, so a host that refuses the
              embed leaves the shop's details showing rather than a grey box. */}
          <div
            class="relative h-[320px] overflow-hidden border border-rule bg-paper-deep lg:h-[400px]"
            data-map
            data-map-src={mapEmbed}
            data-map-title={`Carte : ${business.name}, ${fullAddress}`}
          >
            <div class="absolute inset-0 flex flex-col items-center justify-center gap-3 px-6 text-center">
              <Icon name="pin" class="size-8 text-crimson" />
              <p class="max-w-xs">
                <span class="block font-display text-lg font-bold text-ink">{business.name}</span>
                <span class="mt-1 block text-[0.95rem] text-steel">{fullAddress}</span>
              </p>
            </div>

          </div>

          {/* Outside the frame on purpose: whatever the embed does — loads,
              refuses, or is blocked by the host — this link is still there. */}
          <div class="mt-2.5 flex flex-wrap items-center gap-x-4 gap-y-1">
            <a
              href={googleMaps}
              target="_blank"
              rel="noopener"
              data-map-fallback
              class="inline-flex min-h-11 items-center text-sm font-semibold text-crimson underline decoration-crimson/40 underline-offset-4 transition-colors hover:decoration-crimson"
            >
              Ouvrir dans Google Maps
            </a>
            <p class="text-sm text-steel-light">
              Carte Google. Aucun autre service tiers sur ce site.
            </p>
          </div>
        </div>

        <div class="relative overflow-hidden" data-reveal data-parallax>
          <Image
            src={rue}
            alt="L'avenue de la République devant le garage, avec la piste cyclable et le stationnement"
            widths={[640, 1024, 1360]}
            sizes="(min-width: 1024px) 560px, 100vw"
            loading="lazy"
            class="aspect-[16/10] w-full object-cover"
          />
          <span class="absolute inset-x-0 bottom-0 h-1.5 bg-crimson" aria-hidden="true"></span>
        </div>
      </div>
    </div>
  </div>
</section>
