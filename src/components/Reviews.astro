---
import { reviews, reviewsVerified, business } from '../config/business.js';
import Stars from './Stars.astro';

const { rating } = business;
---

<section id="avis" class="scroll-mt-20 border-t border-rule bg-surface py-section">
  <div class="mx-auto max-w-6xl px-5 lg:px-8">
    <div class="flex flex-col gap-8 sm:flex-row sm:items-end sm:justify-between">
      <div class="max-w-lg">
        <span class="band" data-reveal></span>
        <h2 class="mt-5 font-display text-[clamp(1.9rem,4.5vw,2.9rem)] font-extrabold" data-reveal>
          251 avis, et une moyenne qui tient
        </h2>
      </div>

      <div class="flex shrink-0 items-center gap-5" data-reveal>
        <p class="font-display text-[3.5rem] font-extrabold leading-none tracking-tight text-ink">
          {rating.value.toString().replace('.', ',')}
        </p>
        <div class="border-l border-rule pl-5">
          <Stars value={rating.value} size="size-4" />
          <p class="mt-1.5 text-[0.95rem] text-steel">
            <span class="font-semibold text-ink">{rating.count} avis</span> Google
          </p>
        </div>
      </div>
    </div>

    {!reviewsVerified && (
      <p
        class="mt-10 flex items-start gap-3 border-l-4 border-amber-500 bg-amber-50 px-5 py-4 text-[0.95rem] leading-relaxed text-amber-900"
        data-placeholder-warning
      >
        <span aria-hidden="true" class="mt-0.5 font-bold">!</span>
        <span>
          <strong class="font-semibold">Contenu de démonstration.</strong> Les textes ci-dessous
          sont des gabarits de mise en page, pas de vrais avis. Ils doivent être remplacés par le
          libellé exact des avis Google avant mise en ligne — publier de faux avis est sanctionné
          (art. L121-2 du Code de la consommation). Ce bandeau disparaît dès que{' '}
          <code class="bg-amber-100 px-1.5 py-0.5 text-[0.85em]">reviewsVerified</code> passe à{' '}
          <code class="bg-amber-100 px-1.5 py-0.5 text-[0.85em]">true</code>.
        </span>
      </p>
    )}

    {/* Snap row on mobile, plain grid from md. Native scroll-snap, no JS. */}
    <ul
      class="mt-10 flex snap-x snap-mandatory gap-6 overflow-x-auto pb-4 [scrollbar-width:none] md:grid md:grid-cols-2 md:overflow-visible md:pb-0 lg:grid-cols-4 [&::-webkit-scrollbar]:hidden"
    >
      {reviews.map((review) => (
        <li
          class="flex w-[82vw] shrink-0 snap-start flex-col border-t-2 border-ink pt-5 sm:w-[55vw] md:w-auto"
          data-reveal
        >
          <Stars value={review.rating} size="size-[0.9rem]" />
          <p class="mt-4 flex-1 text-[1.02rem] leading-relaxed text-ink-soft">« {review.text} »</p>
          <p class="mt-5 font-display text-base font-bold text-ink">{review.author}</p>
          <p class="label mt-0.5 text-steel-light">{review.highlight}</p>
        </li>
      ))}
    </ul>

    <p class="mt-3 text-sm text-steel-light md:hidden" aria-hidden="true">
      Faites défiler pour lire les autres →
    </p>
  </div>
</section>
