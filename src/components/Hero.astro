---
import { Image } from 'astro:assets';
import { business } from '../config/business.js';
import { isOpenAt } from '../lib/hours.js';
import devanture from '../assets/devanture-soir.jpeg';
import Icon from './Icon.astro';
import Stars from './Stars.astro';

const { rating, phone, address } = business;
const openNow = isOpenAt(business.hours, new Date());
---

{/*
  Light ground, photo beside the copy rather than under it. Text laid over a
  darkened photograph was fighting the shop's own signage and reading as stock
  — here the storefront gets to be itself in its own panel.
*/}
<section id="top" class="relative overflow-hidden bg-paper pt-24 lg:pt-28">
  <div class="mx-auto max-w-6xl px-5 lg:px-8">
    <div class="grid items-center gap-8 py-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)] lg:gap-14 lg:py-14">
      <div>
        <!-- The long form wraps to two lines on a phone and pushes the rating
             below the fold, so the street is only named from sm up. -->
        <p class="label flex items-center gap-3" data-reveal>
          <span class="band shrink-0"></span>
          <span>
            Épinay-sur-Seine<span class="hidden sm:inline"> · avenue de la République</span>
          </span>
        </p>

        <h1
          class="mt-6 max-w-xl font-display text-[clamp(2.4rem,6.5vw,4rem)] font-extrabold text-ink"
          data-reveal
        >
          Le garage et le magasin de pièces,{' '}
          <span class="text-crimson">au même endroit.</span>
        </h1>

        <p class="mt-5 max-w-lg text-lg text-steel" data-reveal>
          On diagnostique, on répare, et la pièce est en rayon derrière le
          comptoir. Particuliers et professionnels.
        </p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center" data-reveal>
          <a
            href={`tel:${phone.tel}`}
            data-analytics="call-hero"
            class="inline-flex items-center justify-center gap-3 bg-crimson px-7 py-4 font-display text-xl font-bold tracking-tight text-white transition-colors hover:bg-crimson-deep"
          >
            <Icon name="phone" class="size-5" />
            {phone.display}
          </a>
          <a
            href="#services"
            class="inline-flex items-center justify-center gap-2 border border-rule-strong px-7 py-4 font-display text-lg font-semibold text-ink transition-colors hover:border-ink"
          >
            Ce qu'on fait
            <Icon name="arrow" class="size-4" />
          </a>
        </div>

        <!-- Rating and open-state sit under the CTA on a hairline, the way a
             shop window card carries its details under the name. -->
        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-rule pt-6" data-reveal>
          <p class="flex items-center gap-2.5">
            <Stars value={rating.value} size="size-[1.05rem]" />
            <span class="font-display text-lg font-bold tabular-nums text-ink" data-count={rating.value} data-count-decimals="1">
              {rating.value.toString().replace('.', ',')}
            </span>
            <span class="text-[0.95rem] text-steel">
              · <span class="font-semibold text-ink-soft"><span class="tabular-nums" data-count={rating.count}>{rating.count}</span> avis</span> Google
            </span>
          </p>

          <p
            class="flex items-center gap-2 text-[0.95rem] font-semibold"
            data-open-badge
            data-open={openNow ? 'true' : 'false'}
          >
            <span
              class:list={['size-2 rounded-full', openNow ? 'bg-emerald-600' : 'bg-steel-light']}
              data-open-dot
              aria-hidden="true"
            ></span>
            <span data-open-text class={openNow ? 'text-emerald-700' : 'text-steel'}>
              {openNow ? 'Ouvert maintenant' : 'Fermé actuellement'}
            </span>
          </p>
        </div>
      </div>

      <div class="relative overflow-hidden" data-reveal data-hero-photo>
        <Image
          src={devanture}
          alt={`La devanture de ${business.name}, ${address.street} à ${address.city}`}
          widths={[640, 1024, 1360]}
          sizes="(min-width: 1024px) 620px, 100vw"
          loading="eager"
          fetchpriority="high"
          class="aspect-[4/3] w-full object-cover lg:aspect-[5/4]"
        />
        <!-- The crimson band off the awning, anchoring the photo to the page. -->
        <span class="absolute inset-x-0 bottom-0 h-1.5 bg-crimson" aria-hidden="true"></span>
      </div>
    </div>
  </div>
</section>
