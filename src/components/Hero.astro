---
import { Image } from 'astro:assets';
import { business } from '../config/business.js';
import { isOpenAt } from '../lib/hours.js';
import devanture from '../assets/devanture-soir.jpeg';
import Icon from './Icon.astro';
import Stars from './Stars.astro';

const { rating, phone, address } = business;
// Build-time guess; open-state.ts re-evaluates against the visitor's own clock.
const openNow = isOpenAt(business.hours, new Date());
---

<section id="top" class="relative isolate flex min-h-[100svh] flex-col justify-end overflow-hidden">
  <Image
    src={devanture}
    alt={`Devanture de ${business.name}, ${address.street} à ${address.city}`}
    widths={[640, 1024, 1600, 2048]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 -z-20 size-full object-cover object-center"
  />
  <!--
    Three scrims. The vertical one seats the text; the horizontal one keeps the
    left column near-solid so the shop's own signage stops competing with the
    headline; the flat wash holds contrast where the sky blows out. The photo is
    meant to read as texture and place, not as a second logo.
  -->
  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink-950 via-ink-950/90 to-ink-950/55"></div>
  <div class="absolute inset-0 -z-10 bg-gradient-to-r from-ink-950 via-ink-950/75 to-ink-950/20"></div>
  <div class="absolute inset-0 -z-10 bg-ink-950/25"></div>

  <!-- pb adds --call-bar-h so the last CTA never lands under the fixed mobile
       call bar. The variable is 0 from lg up, where lg:pb-24 takes over. -->
  <div
    class="mx-auto w-full max-w-6xl px-5 pb-[calc(3.5rem+var(--call-bar-h))] pt-28 lg:px-8 lg:pb-24 lg:pt-32"
  >
    <p class="eyebrow" data-reveal>{address.city} · {address.postalCode}</p>

    <!-- Headline stays white on purpose: red is the colour of the call button.
         Spending it on the title too would cost the CTA its pull. -->
    <h1
      class="mt-4 max-w-3xl font-display text-[clamp(2.6rem,9vw,5.5rem)] font-bold uppercase leading-[0.94] tracking-[-0.02em] text-white"
      data-reveal
    >
      Réparation auto<br />&amp; pièces détachées
    </h1>

    <p class="mt-6 max-w-lg text-lg leading-relaxed text-chrome-100 lg:text-xl" data-reveal>
      Atelier et magasin au {address.street}. Entretien, freinage, diagnostic,
      pneus — et les pièces en stock, pour les particuliers comme pour les pros.
    </p>

    <!-- Social proof sits above the fold, before the CTA: the rating is what
         earns the tap on the call button. -->
    <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-3" data-reveal>
      <div class="flex items-center gap-3">
        <Stars value={rating.value} size="size-5" />
        <span class="font-display text-2xl font-bold leading-none text-white">
          {rating.value.toString().replace('.', ',')}
        </span>
        <span class="text-sm text-chrome-300">
          sur 5 · <span class="font-semibold text-chrome-100">{rating.count} avis</span> Google
        </span>
      </div>

      <span class="hidden h-5 w-px bg-ink-600 sm:block"></span>

      <p
        class="inline-flex items-center gap-2 text-sm font-medium"
        data-open-badge
        data-open={openNow ? 'true' : 'false'}
      >
        <span
          class:list={[
            'size-2 rounded-full',
            openNow ? 'bg-emerald-400' : 'bg-chrome-400',
          ]}
          data-open-dot
          aria-hidden="true"
        ></span>
        <span data-open-text class={openNow ? 'text-emerald-300' : 'text-chrome-300'}>
          {openNow ? 'Ouvert maintenant' : 'Fermé actuellement'}
        </span>
      </p>
    </div>

    <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center" data-reveal>
      <a
        href={`tel:${phone.tel}`}
        data-analytics="call-hero"
        class="inline-flex items-center justify-center gap-3 rounded-full bg-signal px-8 py-4 font-display text-xl font-semibold tracking-wide text-white transition-colors hover:bg-signal-hover"
      >
        <Icon name="phone" class="size-5" />
        {phone.display}
      </a>
      <a
        href="#services"
        class="inline-flex items-center justify-center gap-2 rounded-full border border-ink-600 px-8 py-4 font-display text-lg font-medium tracking-wide text-chrome-100 transition-colors hover:border-chrome-400 hover:text-white"
      >
        Nos prestations
        <Icon name="arrow" class="size-4" />
      </a>
    </div>
  </div>
</section>
