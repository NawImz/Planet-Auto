---
import { business } from '../config/business.js';
import Icon from './Icon.astro';

const { phone, address } = business;

/*
  Phone only, by design.

  A message form was built and removed: a static site has no inbox, so it had
  to hand the message off to WhatsApp or a mail client, and that indirection
  bought nothing a garage needs. The call is the conversion, and the number is
  never more than a thumb away — header on desktop, fixed bar on mobile.
*/

// What to have ready makes the call shorter for both sides.
const beforeCalling = [
  'La marque, le modèle et l’année du véhicule',
  'La motorisation si vous la connaissez (essence, diesel, cylindrée)',
  'Le symptôme : bruit, voyant, fuite, depuis quand',
  'Pour une pièce : la référence, ou la carte grise sous la main',
];
---

<section id="contact" class="scroll-mt-20 border-t border-rule bg-surface py-section">
  <div class="mx-auto max-w-6xl px-5 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <span class="band" data-reveal></span>
        <h2 class="mt-5 font-display text-[clamp(1.9rem,4.5vw,2.9rem)] font-extrabold" data-reveal>
          Le plus simple,<br />c'est d'appeler
        </h2>
        <p class="mt-4 max-w-md text-lg text-steel" data-reveal>
          Deux minutes au téléphone et vous savez si la pièce est en stock et
          quand on peut vous prendre. C'est le garage qui décroche, pas un
          standard.
        </p>

        <a
          href={`tel:${phone.tel}`}
          data-analytics="call-contact"
          class="mt-8 flex items-center gap-5 border border-rule bg-paper p-6 transition-colors hover:border-crimson"
          data-reveal
        >
          <span class="inline-flex size-14 shrink-0 items-center justify-center bg-crimson text-white">
            <Icon name="phone" class="size-7" />
          </span>
          <span class="min-w-0">
            <span class="label block">Appeler le garage</span>
            <span class="mt-1 block font-display text-[clamp(1.6rem,4.5vw,2.1rem)] font-extrabold leading-none tracking-tight text-ink">
              {phone.display}
            </span>
          </span>
        </a>

        <dl class="mt-8 space-y-3 border-t border-rule pt-8 text-steel" data-reveal>
          <div class="flex items-start gap-3">
            <dt class="sr-only">Adresse</dt>
            <Icon name="pin" class="mt-1 size-5 shrink-0 text-crimson" />
            <dd>{address.street}, {address.postalCode} {address.city}</dd>
          </div>
          <div class="flex items-start gap-3">
            <dt class="sr-only">Horaires</dt>
            <Icon name="clock" class="mt-1 size-5 shrink-0 text-crimson" />
            <dd>Lun–Ven 9h–12h30 · 14h–19h &nbsp;|&nbsp; Sam 9h–18h &nbsp;|&nbsp; Dim fermé</dd>
          </div>
        </dl>
      </div>

      <div data-reveal>
        <div class="border border-rule bg-paper p-7 lg:p-9">
          <h3 class="font-display text-2xl font-bold">Avant d'appeler</h3>
          <p class="mt-3 text-steel">
            Rien d'obligatoire, mais avec ça sous la main on vous répond en une
            fois au lieu de vous rappeler.
          </p>

          <ul class="mt-6 border-t border-rule">
            {beforeCalling.map((item) => (
              <li class="flex items-start gap-3 border-b border-rule py-3.5">
                <Icon name="check" class="mt-1 size-4 shrink-0 text-crimson" />
                <span class="text-ink-soft">{item}</span>
              </li>
            ))}
          </ul>

          <p class="mt-6 text-[0.95rem] leading-relaxed text-steel-light">
            Vous pouvez aussi passer directement au comptoir aux horaires
            d'ouverture&nbsp;: on regarde la pièce ou le véhicule avec vous.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
