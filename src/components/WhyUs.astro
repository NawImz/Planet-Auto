---
import { Image } from 'astro:assets';
import { benefits, business } from '../config/business.js';
import boutique from '../assets/boutique-interieur.jpeg';
import Icon from './Icon.astro';
---

<section id="atouts" class="scroll-mt-20 border-t border-ink-800 bg-ink-900 py-section">
  <div class="mx-auto max-w-6xl px-5 lg:px-8">
    <div class="grid gap-14 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:gap-20">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <p class="eyebrow" data-reveal>Pourquoi nous</p>
        <h2
          class="mt-4 font-display text-[clamp(2rem,5.5vw,3.5rem)] font-bold uppercase leading-[1.02] tracking-[-0.015em] text-white"
          data-reveal
        >
          Ce qui change<br />concrètement
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-chrome-300" data-reveal>
          Quatre engagements qui reviennent dans ce que nos clients racontent.
        </p>

        <div class="mt-10 overflow-hidden rounded-2xl border border-ink-700" data-reveal>
          <Image
            src={boutique}
            alt="Rayon outillage et pièces détachées dans le magasin Planet Auto"
            widths={[400, 574, 900]}
            sizes="(min-width: 1024px) 420px, 100vw"
            loading="lazy"
            class="aspect-[4/3] w-full object-cover object-center lg:aspect-[3/4]"
          />
        </div>
      </div>

      <ul class="space-y-px overflow-hidden rounded-2xl border border-ink-700 bg-ink-700">
        {benefits.map((benefit, index) => (
          <li class="bg-ink-900 p-7 lg:p-9" data-reveal>
            <div class="flex items-baseline gap-4">
              <span class="font-display text-sm font-bold tabular-nums text-signal-bright">
                {String(index + 1).padStart(2, '0')}
              </span>
              <div class="min-w-0">
                <h3 class="font-display text-2xl font-semibold uppercase tracking-tight text-white lg:text-[1.75rem]">
                  {benefit.title}
                </h3>
                <p class="mt-3 leading-relaxed text-chrome-300">{benefit.description}</p>
                <p class="mt-4 inline-flex items-center gap-2 rounded-full bg-ink-850 px-3.5 py-1.5 font-display text-xs font-semibold uppercase tracking-[0.12em] text-chrome-100 ring-1 ring-ink-700">
                  <Icon name="check" class="size-3.5 text-signal-bright" />
                  {benefit.stat}
                </p>
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>

    <div
      class="mt-14 flex flex-wrap items-center gap-x-8 gap-y-4 rounded-2xl border border-ink-700 bg-ink-850 px-7 py-6"
      data-reveal
    >
      <p class="inline-flex items-center gap-3 text-sm text-chrome-100">
        <Icon name="accessibility" class="size-5 shrink-0 text-signal-bright" />
        Parking et entrée accessibles PMR
      </p>
      <p class="inline-flex items-center gap-3 text-sm text-chrome-100">
        <Icon name="card" class="size-5 shrink-0 text-signal-bright" />
        {business.paymentAccepted.join(' · ')}
      </p>
    </div>
  </div>
</section>
