---
import { business } from '../config/business.js';
import Icon from './Icon.astro';

const nav = [
  { href: '#services', label: 'Services' },
  { href: '#atouts', label: 'Pourquoi nous' },
  { href: '#avis', label: 'Avis' },
  { href: '#acces', label: 'Accès' },
  { href: '#contact', label: 'Contact' },
];
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 transition-[background-color,border-color,backdrop-filter] duration-300 border-b border-transparent"
  data-header
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5 lg:h-20 lg:px-8">
    <a
      href="#top"
      class="-ml-1 flex min-h-11 items-center px-1"
      aria-label={`${business.name} — accueil`}
    >
      <span class="font-display text-xl font-bold tracking-tight text-white lg:text-2xl">
        PLANET<span class="text-signal-bright">AUTO</span>
      </span>
    </a>

    <nav aria-label="Navigation principale" class="hidden items-center gap-4 lg:flex">
      {nav.map((item) => (
        <a
          href={item.href}
          class="inline-flex min-h-11 min-w-11 items-center justify-center px-3 font-display text-sm font-medium uppercase tracking-wider text-chrome-300 transition-colors hover:text-white"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <!-- Desktop: the call CTA lives in the header. On mobile it lives in the
           bottom bar instead, within thumb reach, so it is not duplicated here. -->
      <a
        href={`tel:${business.phone.tel}`}
        data-analytics="call-header"
        class="hidden items-center gap-2.5 rounded-full bg-signal px-5 py-2.5 font-display text-base font-semibold tracking-wide text-white transition-colors hover:bg-signal-hover lg:inline-flex"
      >
        <Icon name="phone" class="size-4" />
        {business.phone.display}
      </a>

      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-nav"
        class="-mr-2 inline-flex size-11 items-center justify-center rounded-lg text-white lg:hidden"
      >
        <span class="sr-only">Ouvrir le menu</span>
        <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <path data-menu-icon-open d="M4 7h16M4 12h16M4 17h16" />
          <path data-menu-icon-close class="hidden" d="M6 6l12 12M18 6 6 18" />
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    aria-label="Navigation mobile"
    class="hidden border-t border-ink-700 bg-ink-950/98 backdrop-blur lg:hidden"
    data-mobile-nav
  >
    <ul class="mx-auto max-w-6xl px-5 py-2">
      {nav.map((item) => (
        <li class="border-b border-ink-800 last:border-0">
          <a
            href={item.href}
            data-mobile-link
            class="block py-4 font-display text-lg font-medium uppercase tracking-wide text-chrome-100"
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
