---
import { business, reviews, reviewsVerified, services, faq, SITE_URL } from '../config/business.js';
import { toOpeningHoursSpecification } from '../lib/hours.js';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Path only, e.g. "/". */
  path?: string;
}

const { title, description, path = '/' } = Astro.props;
const canonical = new URL(path, SITE_URL).href;
const { address, phone, rating, hours } = business;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'AutoRepair',
  '@id': `${SITE_URL}#business`,
  name: business.name,
  description:
    "Atelier de réparation automobile et distributeur de pièces détachées à Épinay-sur-Seine : entretien, freinage, diagnostic, pneus et pièces toutes marques.",
  url: SITE_URL,
  telephone: phone.tel,
  address: {
    '@type': 'PostalAddress',
    streetAddress: address.street,
    postalCode: address.postalCode,
    addressLocality: address.city,
    addressCountry: address.country,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: address.lat,
    longitude: address.lng,
  },
  openingHoursSpecification: toOpeningHoursSpecification(hours),
  // sameAs is how Google ties this site, the Google listing and the Facebook
  // page together as one business rather than three unrelated results.
  ...(business.social.length ? { sameAs: business.social.map((s) => s.href) } : {}),
  image: new URL('/og-image.jpg', SITE_URL).href,
  logo: new URL('/favicon.svg', SITE_URL).href,
  hasMap: `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
    `${business.name}, ${address.street}, ${address.postalCode} ${address.city}`
  )}`,
  // Naming the trades explicitly is what lets Google match the page to
  // "réparation freinage Épinay" rather than only to the shop's own name.
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Prestations et pièces',
    itemListElement: services.map((s) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: s.title, description: s.description },
    })),
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: rating.value,
    reviewCount: rating.count,
    bestRating: 5,
  },
  // Only the town the shop is in. The neighbouring communes previously listed
  // here were picked off a map, not given by the garage — declaring a service
  // area to Google is a claim like any other.
  areaServed: [{ '@type': 'City', name: address.city }],
  // Individual reviews are only declared once their text is the genuine
  // Google wording. Publishing placeholder copy as structured review data
  // would be feeding Google fabricated testimonials.
  ...(reviewsVerified
    ? {
        review: reviews.map((r) => ({
          '@type': 'Review',
          author: { '@type': 'Person', name: r.author },
          reviewRating: { '@type': 'Rating', ratingValue: r.rating, bestRating: 5 },
          reviewBody: r.text,
        })),
      }
    : {}),
};

/*
  A second block rather than a nested property: FAQPage is its own type, and
  Google reads the two independently. Every answer below is built from facts
  already in business.js, so the markup cannot drift from the page.
*/
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<!doctype html>
<html lang="fr" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#f5f3f0" />
    <meta name="geo.region" content="FR-93" />
    <meta name="geo.placename" content="Épinay-sur-Seine" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og-image.jpg', SITE_URL).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`Devanture de ${business.name}, ${address.street} à ${address.city}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL('/og-image.jpg', SITE_URL).href} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <script is:inline>
      // Flip off the no-JS fallback before first paint so reveal elements start
      // hidden only when GSAP will actually be there to reveal them.
      document.documentElement.classList.remove('no-js');
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('reveal-disabled');
      }
    </script>

    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <slot />
  </body>
</html>
