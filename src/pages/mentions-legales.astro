---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCallBar from '../components/StickyCallBar.astro';
import { business } from '../config/business.js';

const { address, phone } = business;

/*
  Placeholders marked [À COMPLÉTER] are legally required by art. 6-III of the
  LCEN (loi n°2004-575) and cannot be guessed: they come from the client's Kbis
  and from the hosting contract. The page ships so the footer link is not a 404,
  but it is not compliant until they are filled in.
*/
---

<Layout
  title="Mentions légales | Planet Auto"
  description="Mentions légales du site de Planet Auto, garage et magasin de pièces détachées à Épinay-sur-Seine."
  path="/mentions-legales"
>
  <Header />
  <main id="contenu" class="pt-28 lg:pt-36">
    <div class="mx-auto max-w-3xl px-5 pb-24 lg:px-8">
      <h1 class="font-display text-[clamp(2.2rem,6vw,3.5rem)] font-extrabold leading-tight tracking-tight text-ink">
        Mentions légales
      </h1>

      <div class="mt-12 space-y-10 leading-relaxed text-steel">
        <section>
          <h2 class="font-display text-xl font-semibold text-ink">Éditeur du site</h2>
          <p class="mt-3">
            {business.legalName}<br />
            {address.street}, {address.postalCode} {address.city}<br />
            Téléphone : <a href={`tel:${phone.tel}`} class="text-crimson underline underline-offset-4">{phone.display}</a>
          </p>
          <p class="mt-3">
            Forme juridique : <span class="text-steel-light">[À COMPLÉTER]</span><br />
            SIRET : <span class="text-steel-light">[À COMPLÉTER]</span><br />
            N° TVA intracommunautaire : <span class="text-steel-light">[À COMPLÉTER]</span><br />
            Directeur de la publication : <span class="text-steel-light">[À COMPLÉTER]</span>
          </p>
        </section>

        <section>
          <h2 class="font-display text-xl font-semibold text-ink">Hébergement</h2>
          <p class="mt-3 text-steel-light">
            [À COMPLÉTER — raison sociale, adresse et téléphone de l'hébergeur]
          </p>
        </section>

        <section>
          <h2 class="font-display text-xl font-semibold text-ink">Données personnelles</h2>
          <p class="mt-3">
            Ce site ne collecte et n'enregistre aucune donnée personnelle. Il ne comporte ni
            compte, ni base de données, ni formulaire transmis à un serveur.
          </p>
          <p class="mt-3">
            Si vous nous écrivez depuis le site, le message est composé dans votre propre
            application (messagerie ou e-mail) et nous parvient par ce canal&nbsp;: il n'est
            à aucun moment stocké ici. Les échanges qui s'ensuivent servent uniquement à
            traiter votre demande et ne font l'objet d'aucune cession à des tiers.
          </p>
          <p class="mt-3">
            Conformément au RGPD et à la loi Informatique et Libertés, vous disposez d'un droit
            d'accès, de rectification, d'effacement et d'opposition sur les données que vous nous
            auriez communiquées. Pour l'exercer, contactez-nous au {phone.display} ou à l'adresse
            indiquée ci-dessus.
          </p>
        </section>

        <section>
          <h2 class="font-display text-xl font-semibold text-ink">Cookies</h2>
          <p class="mt-3">
            Ce site ne dépose aucun cookie de mesure d'audience ni de publicité. La carte est
            fournie par OpenStreetMap, qui ne dépose pas de traceur publicitaire.
          </p>
        </section>

        <section>
          <h2 class="font-display text-xl font-semibold text-ink">Propriété intellectuelle</h2>
          <p class="mt-3">
            L'ensemble des contenus de ce site (textes, photographies, identité visuelle) est
            protégé. Toute reproduction sans autorisation préalable est interdite.
          </p>
        </section>
      </div>

      <a
        href="/"
        class="mt-14 inline-flex items-center gap-2 font-display text-sm font-semibold uppercase tracking-wider text-crimson"
      >
        ← Retour à l'accueil
      </a>
    </div>
  </main>
  <Footer />
  <StickyCallBar />
</Layout>
