---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  class?: string;
}

const { eyebrow, title, lead, class: className = '' } = Astro.props;
---

<div class={`max-w-2xl ${className}`}>
  <p class="eyebrow" data-reveal>{eyebrow}</p>
  <h2
    class="mt-4 font-display text-[clamp(2rem,5.5vw,3.5rem)] font-bold uppercase leading-[1.02] tracking-[-0.015em] text-white"
    data-reveal
  >
    {title}
  </h2>
  {lead && (
    <p class="mt-5 text-lg leading-relaxed text-chrome-300" data-reveal>
      {lead}
    </p>
  )}
</div>
