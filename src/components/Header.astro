---
import { business } from '../config/business.js';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

const nav = [
  { href: '#services', label: 'Prestations' },
  { href: '#atouts', label: 'La maison' },
  { href: '#avis', label: 'Avis' },
  { href: '#acces', label: 'Accès' },
  { href: '#faq', label: 'FAQ' },
];
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-[background-color,border-color,box-shadow] duration-300"
  data-header
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-6 px-5 lg:h-20 lg:px-8">
    <a href="#top" class="-ml-1 flex min-h-11 items-center px-1" aria-label={`${business.name} — accueil`}>
      <Logo class="text-[1.35rem] lg:text-[1.6rem]" markClass="w-12 lg:w-16" />
    </a>

    <nav aria-label="Navigation principale" class="hidden items-center gap-1 lg:flex">
      {nav.map((item) => (
        <a
          href={item.href}
          class="inline-flex min-h-11 items-center px-3.5 text-[0.95rem] font-semibold text-steel transition-colors hover:text-ink"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <!-- Desktop only. On mobile the call CTA lives in the bottom bar, in
           thumb reach, so it is not repeated up here. -->
      <a
        href={`tel:${business.phone.tel}`}
        data-analytics="call-header"
        class="hidden items-center gap-2.5 bg-crimson px-5 py-3 font-display text-base font-bold tracking-tight text-white transition-colors hover:bg-crimson-deep lg:inline-flex"
      >
        <Icon name="phone" class="size-4" />
        {business.phone.display}
      </a>

      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-nav"
        class="-mr-2 inline-flex size-11 items-center justify-center text-ink lg:hidden"
      >
        <span class="sr-only">Ouvrir le menu</span>
        <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <path data-menu-icon-open d="M4 7h16M4 12h16M4 17h16"></path>
          <path data-menu-icon-close class="hidden" d="M6 6l12 12M18 6 6 18"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    aria-label="Navigation mobile"
    class="hidden border-t border-rule bg-surface lg:hidden"
    data-mobile-nav
  >
    <ul class="mx-auto max-w-6xl px-5">
      {nav.map((item) => (
        <li class="border-b border-rule last:border-0">
          <a href={item.href} data-mobile-link class="block py-4 font-display text-lg font-bold text-ink">
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
