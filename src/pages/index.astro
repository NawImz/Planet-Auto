---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import WhyUs from '../components/WhyUs.astro';
import Reviews from '../components/Reviews.astro';
import Location from '../components/Location.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import StickyCallBar from '../components/StickyCallBar.astro';
import CookieConsent from '../components/CookieConsent.astro';
---

<Layout
  title="Garage Épinay-sur-Seine — Réparation auto & pièces détachées | Planet Auto"
  description="Garage à Épinay-sur-Seine (93800) : réparation, entretien, freinage, diagnostic, pneus et pièces détachées toutes marques. 4,6/5 sur 251 avis. ☎ 01 49 98 14 20"
  path="/"
>
  <Header />
  <main id="contenu">
    <Hero />
    <Services />
    <WhyUs />
    <Reviews />
    <Location />
    <Faq />
    <Contact />
  </main>
  <Footer />
  <StickyCallBar />
  <CookieConsent />
</Layout>

<script>
  import '../scripts/main.ts';
</script>
