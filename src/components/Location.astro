---
import { Image } from 'astro:assets';
import { business } from '../config/business.js';
import { formatRanges } from '../lib/hours.js';
import rue from '../assets/rue-acces.jpeg';
import plan from '../assets/plan-acces.png';
import Icon from './Icon.astro';

const { address, hours } = business;

const fullAddress = `${address.street}, ${address.postalCode} ${address.city}`;

/*
  A cropped capture of the Google listing, at the client's request, in place of
  the live embed.

  It buys more than it gives up. The embed was the only third party on the
  page: it set cookies the moment the iframe entered the document, which meant
  a consent bar, a stored choice, and a grey box for every visitor who refused
  or whose browser blocked it. A static plan always draws, costs one cached
  request, and leaves the site with no third-party call at all.

  What the frame loses — panning, zooming, the listing card — is exactly what
  the "Itinéraire" button gives back, and that is what a visitor standing on
  the pavement actually taps.

  Regenerate with: node scripts/make-map.mjs <capture.jpg>
*/
const query = encodeURIComponent(`${business.name}, ${fullAddress}`);
const googleMaps = `https://www.google.com/maps/search/?api=1&query=${query}`;
const waze = `https://waze.com/ul?q=${query}`;
---

<section id="acces" class="scroll-mt-20 border-t border-rule bg-paper py-section">
  <div class="mx-auto max-w-6xl px-5 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <span class="band" data-reveal></span>
        <h2 class="mt-5 font-display text-[clamp(1.9rem,4.5vw,2.9rem)] font-extrabold" data-reveal>
          Venir nous voir
        </h2>

        <address class="mt-6 not-italic text-xl leading-relaxed text-ink" data-reveal>
          {address.street}<br />
          {address.postalCode} {address.city}
        </address>
        <p class="mt-2 text-steel" data-reveal>
          Sur l'avenue, entre la rue Ampère et la rue Branly. Stationnement de
          rue devant l'atelier.
        </p>

        <div class="mt-6 flex flex-wrap gap-3" data-reveal>
          <a
            href={googleMaps}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 bg-crimson px-6 py-3.5 font-display font-bold text-white transition-colors hover:bg-crimson-deep"
          >
            <Icon name="pin" class="size-4" />
            Itinéraire
          </a>
          <a
            href={waze}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 border border-rule-strong px-6 py-3.5 font-display font-semibold text-ink transition-colors hover:border-ink"
          >
            Waze
          </a>
        </div>

        <h3 class="label mt-12 border-t border-rule pt-8 text-ink" data-reveal>Horaires</h3>
        <dl class="mt-4" data-reveal>
          {hours.map((day) => (
            <div class="flex items-baseline justify-between gap-4 border-b border-rule py-2.5">
              <dt class="font-semibold text-ink">{day.day}</dt>
              <dd
                class:list={[
                  'text-right tabular-nums',
                  day.ranges.length ? 'text-ink-soft' : 'text-steel-light',
                ]}
              >
                {formatRanges(day.ranges)}
              </dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="flex flex-col gap-6">
        {/* The whole plan is the link: on a map, tapping the map is the
            gesture people already have. */}
        <a
          href={googleMaps}
          target="_blank"
          rel="noopener"
          class="group relative block overflow-hidden border border-rule-strong bg-paper-deep transition-colors hover:border-ink"
          data-map
          data-reveal
        >
          <Image
            src={plan}
            alt={`Plan du quartier : ${business.name} est indiqué au ${address.street}, sur l'avenue, entre la rue Ampère et la rue Branly`}
            widths={[560, 800, 1120]}
            sizes="(min-width: 1024px) 560px, 100vw"
            loading="lazy"
            class="aspect-[4/3] w-full object-cover lg:aspect-[7/5]"
          />

          <span
            class="absolute inset-x-0 bottom-0 flex items-center justify-between gap-3 bg-surface/95 px-4 py-3 backdrop-blur-sm"
          >
            <span class="min-w-0">
              <span class="block truncate font-display text-[0.95rem] font-bold text-ink">
                {business.name}
              </span>
              <span class="block truncate text-[0.85rem] text-steel">{fullAddress}</span>
            </span>
            <span class="inline-flex shrink-0 items-center gap-1.5 font-display text-[0.85rem] font-bold text-crimson">
              Ouvrir
              <Icon name="arrow" class="size-4 transition-transform group-hover:translate-x-0.5" />
            </span>
          </span>
        </a>

        {/* Attribution : la capture vient de Google Maps, et leurs conditions
            demandent que la mention reste visible. */}
        <p class="-mt-4 text-right text-[0.78rem] text-steel-light">Plan&nbsp;: © Google</p>

        <div class="relative overflow-hidden" data-reveal data-parallax>
          <Image
            src={rue}
            alt="L'avenue de la République devant le garage, avec la piste cyclable et le stationnement"
            widths={[640, 1024, 1360]}
            sizes="(min-width: 1024px) 560px, 100vw"
            loading="lazy"
            class="aspect-[16/10] w-full object-cover"
          />
          <span class="absolute inset-x-0 bottom-0 h-1.5 bg-crimson" aria-hidden="true"></span>
        </div>
      </div>
    </div>
  </div>
</section>
