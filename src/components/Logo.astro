---
import LogoMark from './LogoMark.astro';

interface Props {
  class?: string;
  markClass?: string;
  /** `stacked` mirrors the left panel of the awning; `inline` the main sign. */
  layout?: 'inline' | 'stacked';
  title?: string;
}

// The mark is landscape, so it is sized by width; a square utility would crop
// the orbit ring at both ends.
const {
  class: className = '',
  markClass = 'w-12',
  layout = 'inline',
  title,
} = Astro.props;
---

{/*
  Set the way the sign is painted: a large initial capital followed by smaller
  capitals, in the squared geometric face, both words in the one red. The
  earlier two-tone PLANET/AUTO split was a design invention — the shopfront
  carries both words the same.

  The colour comes from --wordmark so a dark surface can lift it: the brand
  crimson reaches only 2.7:1 on the footer's ink.
*/}
<span class={`inline-flex items-center gap-2.5 ${className}`}>
  <LogoMark class={markClass} title={title} />
  <span
    class:list={[
      'font-wordmark font-extrabold uppercase leading-[0.92] tracking-[0.005em]',
      layout === 'stacked' ? 'flex flex-col items-start' : 'flex items-baseline gap-[0.28em]',
    ]}
    style="color: var(--wordmark, var(--color-crimson))"
  >
    <span><span class="text-[1.34em]">P</span>lanet</span>
    <span><span class="text-[1.34em]">A</span>uto</span>
  </span>
</span>
