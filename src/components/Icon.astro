---
/*
  Inline SVG sprite. Hand-rolled rather than pulled from an icon package: six
  service glyphs plus UI marks do not justify shipping a library, and inline
  paths cost no extra request.
*/
interface Props {
  name: string;
  class?: string;
  /** Decorative by default; pass a label when the icon carries meaning alone. */
  label?: string;
}

const { name, class: className = 'size-6', label } = Astro.props;

const paths: Record<string, string> = {
  wrench:
    '<path d="M14.7 6.3a4 4 0 0 0 5.02 5.02l-8.4 8.4a2.5 2.5 0 0 1-3.54-3.54l8.4-8.4Z"/><path d="M14.7 6.3 17.5 3.5a4 4 0 0 1 3 6.8"/>',
  oil:
    '<path d="M12 3.5c2.8 3.4 4.5 5.9 4.5 8.2a4.5 4.5 0 0 1-9 0c0-2.3 1.7-4.8 4.5-8.2Z"/><path d="M12 17.8a2.2 2.2 0 0 1-2.2-2.2"/>',
  // A parts cabinet, not a cog: the cog read as a sun at 24px, and a drawer
  // unit is what "pièces en stock" actually looks like on the shop floor.
  gear:
    '<rect x="3.2" y="4.4" width="17.6" height="15.2" rx="2"/><path d="M3.2 12h17.6"/><path d="M10 8.2h4M10 15.8h4"/>',
  scan:
    '<path d="M3.5 8V5.5A2 2 0 0 1 5.5 3.5H8M16 3.5h2.5a2 2 0 0 1 2 2V8M20.5 16v2.5a2 2 0 0 1-2 2H16M8 20.5H5.5a2 2 0 0 1-2-2V16"/><path d="M7 12h2l1.5-3 2.5 6 1.5-3h2"/>',
  // Brake disc reads by its caliper; wheel reads by its bolts. Without those
  // two tells the pair was a near-identical set of concentric circles.
  disc:
    '<circle cx="10.6" cy="12" r="7.6"/><circle cx="10.6" cy="12" r="2.6"/><path d="M18.2 8.6h1.5a1.7 1.7 0 0 1 1.7 1.7v3.4a1.7 1.7 0 0 1-1.7 1.7h-1.5"/>',
  tire:
    '<circle cx="12" cy="12" r="8.4"/><circle cx="12" cy="12" r="4.2"/><circle cx="12" cy="6.1" r="0.95"/><circle cx="17.1" cy="15" r="0.95"/><circle cx="6.9" cy="15" r="0.95"/>',
  phone:
    '<path d="M6.2 3.5h3l1.5 3.8-2 1.3a11.5 11.5 0 0 0 5.2 5.2l1.3-2 3.8 1.5v3a1.7 1.7 0 0 1-1.9 1.7A15.8 15.8 0 0 1 4.5 5.4 1.7 1.7 0 0 1 6.2 3.5Z"/>',
  pin: '<path d="M19 10.5c0 5-7 10.5-7 10.5s-7-5.5-7-10.5a7 7 0 1 1 14 0Z"/><circle cx="12" cy="10.3" r="2.6"/>',
  clock: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.2V12l3.2 1.9"/>',
  check: '<path d="M4.5 12.5 9.5 17.5 19.5 6.5"/>',
  arrow: '<path d="M4.5 12h15M13.5 6l6 6-6 6"/>',
  accessibility:
    '<circle cx="12" cy="4.6" r="1.8"/><path d="M6.5 8.2 12 9.4l5.5-1.2M12 9.4v4.4h3.4l2.3 5.6M12 13.8l-2.6 5.6"/>',
  card:
    '<rect x="2.8" y="5.2" width="18.4" height="13.6" rx="2.2"/><path d="M2.8 9.8h18.4M6.4 14.8h3.2"/>',
  facebook:
    '<path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.52 1.5-3.91 3.77-3.91 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.78-1.63 1.57v1.89h2.78l-.45 2.91h-2.33V22c4.78-.76 8.44-4.92 8.44-9.94Z"/>',
  quote: '<path d="M9.2 6.5C6.3 8 4.8 10.4 4.8 13.7c0 2.4 1.4 3.9 3.3 3.9 1.8 0 3.1-1.3 3.1-3 0-1.8-1.2-3-2.9-3-.3 0-.7 0-.9.2.3-1.6 1.5-3 3.2-4Zm8.6 0c-2.9 1.5-4.4 3.9-4.4 7.2 0 2.4 1.4 3.9 3.3 3.9 1.8 0 3.1-1.3 3.1-3 0-1.8-1.2-3-2.9-3-.3 0-.7 0-.9.2.3-1.6 1.5-3 3.2-4Z"/>',
};

const body = paths[name] ?? '';
if (import.meta.env.DEV && !body) {
  console.warn(`[Icon] unknown icon "${name}"`);
}
const filled = name === 'quote' || name === 'facebook';
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill={filled ? 'currentColor' : 'none'}
  stroke={filled ? 'none' : 'currentColor'}
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  set:html={body}
/>
