---
import { business, contact, services } from '../config/business.js';
import Icon from './Icon.astro';

const { phone, address } = business;

// Which message channel exists decides what this block can honestly offer.
// A form with no reachable inbox is worse than no form: it collects messages
// that nobody reads and quietly loses customers who thought they had written.
const channel = contact.whatsapp ? 'whatsapp' : contact.email ? 'email' : 'phone';

const waBase = contact.whatsapp ? `https://wa.me/${contact.whatsapp}` : null;
const waPlain = waBase
  ? `${waBase}?text=${encodeURIComponent(`Bonjour, je vous contacte au sujet de ma voiture.`)}`
  : null;
---

<section id="contact" class="scroll-mt-20 border-t border-rule bg-surface py-section">
  <div class="mx-auto max-w-6xl px-5 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <span class="band" data-reveal></span>
        <h2 class="mt-5 font-display text-[clamp(1.9rem,4.5vw,2.9rem)] font-extrabold" data-reveal>
          Le plus simple,<br />c'est d'appeler
        </h2>
        <p class="mt-4 max-w-md text-lg text-steel" data-reveal>
          Deux minutes au téléphone et vous savez si la pièce est en stock et
          quand on peut vous prendre. Pas de formulaire à remplir, pas d'attente
          de réponse.
        </p>

        <a
          href={`tel:${phone.tel}`}
          data-analytics="call-contact"
          class="mt-8 flex items-center gap-5 border border-rule bg-paper p-6 transition-colors hover:border-crimson"
          data-reveal
        >
          <span class="inline-flex size-14 shrink-0 items-center justify-center bg-crimson text-white">
            <Icon name="phone" class="size-7" />
          </span>
          <span class="min-w-0">
            <span class="label block">Appeler le garage</span>
            <span class="mt-1 block font-display text-[clamp(1.6rem,4.5vw,2.1rem)] font-extrabold leading-none tracking-tight text-ink">
              {phone.display}
            </span>
          </span>
        </a>

        <dl class="mt-8 space-y-3 border-t border-rule pt-8 text-steel" data-reveal>
          <div class="flex items-start gap-3">
            <dt class="sr-only">Adresse</dt>
            <Icon name="pin" class="mt-1 size-5 shrink-0 text-crimson" />
            <dd>{address.street}, {address.postalCode} {address.city}</dd>
          </div>
          <div class="flex items-start gap-3">
            <dt class="sr-only">Horaires</dt>
            <Icon name="clock" class="mt-1 size-5 shrink-0 text-crimson" />
            <dd>Lun–Ven 9h–12h30 · 14h–19h &nbsp;|&nbsp; Sam 9h–18h &nbsp;|&nbsp; Dim fermé</dd>
          </div>
        </dl>
      </div>

      <div data-reveal>
        {channel === 'phone' ? (
          /*
            No WhatsApp number and no mailbox configured yet, so there is
            nothing to point a form at. Rather than ship one that drops
            messages into a dashboard nobody opens, the block says plainly how
            to reach the garage. Set contact.whatsapp in business.js and this
            turns into a WhatsApp composer.
          */
          <div class="border border-rule bg-paper p-7 lg:p-9">
            <h3 class="font-display text-2xl font-bold">Écrire plutôt qu'appeler&nbsp;?</h3>
            <p class="mt-3 text-steel">
              Le canal écrit n'est pas encore ouvert sur ce site. En attendant, le
              téléphone reste le moyen le plus rapide d'avoir une réponse — c'est
              le garage qui décroche, pas un standard.
            </p>
            <p class="mt-5 border-t border-rule pt-5 text-[0.95rem] text-steel-light">
              Vous pouvez aussi passer directement au comptoir aux horaires
              d'ouverture&nbsp;: on regarde la pièce ou le véhicule avec vous.
            </p>
            <a
              href={`tel:${phone.tel}`}
              data-analytics="call-contact-alt"
              class="mt-4 inline-flex min-h-11 items-center gap-2.5 font-display text-lg font-bold text-crimson transition-colors hover:text-crimson-deep"
            >
              <Icon name="phone" class="size-4" />
              {phone.display}
            </a>
          </div>
        ) : (
          <div class="border border-rule bg-paper p-7 lg:p-9">
            <h3 class="font-display text-2xl font-bold">
              {channel === 'whatsapp' ? 'Envoyer un message WhatsApp' : 'Envoyer un e-mail'}
            </h3>
            <p class="mt-2 text-[0.95rem] text-steel">
              {channel === 'whatsapp'
                ? 'Le message part sur WhatsApp, directement sur le téléphone du garage.'
                : "Le message ouvre votre application mail, pré-rempli."}
            </p>

            {/*
              No server involved: the fields are assembled into a pre-written
              message and handed to WhatsApp (or the mail app). Without JS the
              button below still opens the channel, just without the details
              filled in.
            */}
            <form
              class="mt-6 space-y-5"
              data-compose={channel}
              data-target={channel === 'whatsapp' ? waBase : contact.email}
            >
              <div class="grid gap-5 sm:grid-cols-2">
                <div>
                  <label for="nom" class="label block text-ink">Votre nom</label>
                  <input
                    id="nom" name="nom" type="text" autocomplete="name"
                    class="mt-2 w-full border border-rule-strong bg-surface px-4 py-3 text-ink focus:border-crimson focus:outline-none"
                  />
                </div>
                <div>
                  <label for="vehicule" class="label block text-ink">Véhicule</label>
                  <input
                    id="vehicule" name="vehicule" type="text" placeholder="Marque, modèle, année"
                    class="mt-2 w-full border border-rule-strong bg-surface px-4 py-3 text-ink placeholder:text-steel-light focus:border-crimson focus:outline-none"
                  />
                </div>
              </div>

              <div>
                <label for="sujet" class="label block text-ink">Votre demande</label>
                <select
                  id="sujet" name="sujet"
                  class="mt-2 w-full border border-rule-strong bg-surface px-4 py-3 text-ink focus:border-crimson focus:outline-none"
                >
                  <option value="">— Choisir —</option>
                  {services.map((s) => <option value={s.title}>{s.title}</option>)}
                  <option value="Autre">Autre</option>
                </select>
              </div>

              <div>
                <label for="message" class="label block text-ink">Message</label>
                <textarea
                  id="message" name="message" rows="4"
                  placeholder="Symptôme constaté, pièce recherchée…"
                  class="mt-2 w-full resize-y border border-rule-strong bg-surface px-4 py-3 text-ink placeholder:text-steel-light focus:border-crimson focus:outline-none"
                ></textarea>
              </div>

              <a
                href={channel === 'whatsapp' ? waPlain : `mailto:${contact.email}`}
                data-compose-submit
                class="inline-flex w-full items-center justify-center gap-2.5 bg-crimson px-8 py-4 font-display text-lg font-bold text-white transition-colors hover:bg-crimson-deep"
              >
                {channel === 'whatsapp' ? 'Ouvrir WhatsApp' : 'Ouvrir mon application mail'}
              </a>

              <p class="text-sm leading-relaxed text-steel-light">
                Rien n'est enregistré sur ce site&nbsp;: le message part depuis
                votre propre application, et le garage vous répond dessus.
              </p>
            </form>
          </div>
        )}
      </div>
    </div>
  </div>
</section>
