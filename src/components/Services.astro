---
import { services, business } from '../config/business.js';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
---

<section id="services" class="scroll-mt-20 border-t border-ink-800 py-section">
  <div class="mx-auto max-w-6xl px-5 lg:px-8">
    <SectionHeading
      eyebrow="Prestations"
      title="Atelier et magasin, au même endroit"
      lead="On répare, et on a la pièce en rayon. C'est ce qui évite l'aller-retour entre le garage qui diagnostique et le fournisseur qui commande."
    />

    <ul class="mt-14 grid gap-px overflow-hidden rounded-2xl border border-ink-700 bg-ink-700 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((service) => (
        <li class="group relative bg-ink-950 p-7 transition-colors hover:bg-ink-900 lg:p-8" data-reveal>
          <span class="inline-flex size-12 items-center justify-center rounded-xl bg-ink-850 text-signal-bright ring-1 ring-ink-700 transition-colors group-hover:bg-signal group-hover:text-white group-hover:ring-signal">
            <Icon name={service.icon} class="size-6" />
          </span>
          <h3 class="mt-5 font-display text-2xl font-semibold uppercase tracking-tight text-white">
            {service.title}
          </h3>
          <p class="mt-3 text-[0.95rem] leading-relaxed text-chrome-300">{service.description}</p>
        </li>
      ))}
    </ul>

    <p class="mt-8 text-chrome-300" data-reveal>
      Une pièce précise à trouver ou un doute sur une panne ?
      <a
        href={`tel:${business.phone.tel}`}
        data-analytics="call-services"
        class="font-semibold text-signal-bright underline decoration-signal/50 underline-offset-4 transition-colors hover:decoration-signal-bright"
      >
        Appelez-nous au {business.phone.display}
      </a>, on vous répond directement.
    </p>
  </div>
</section>
