---
/*
  GENERATED by scripts/gen-logo.mjs — edit the generator, not this file.

  The mark redrawn from the shopfront sign: a six-blade turbine around a
  five-bolt hub, inside a tilted orbit ring.
*/
interface Props {
  class?: string;
  title?: string;
}

const { class: className = 'size-10', title } = Astro.props;
const uid = Math.random().toString(36).slice(2, 8);
---

<svg
  class={className}
  viewBox="0 0 200 200"
  fill="none"
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  aria-label={title}
>
  <defs>
    <clipPath id={`rim-${uid}`}>
      <circle cx="100" cy="100" r="64" />
    </clipPath>
  </defs>

  <!-- orbit, far side -->
  <ellipse
    cx="100" cy="100" rx="95" ry="35"
    transform="rotate(-21 100 100)"
    stroke="var(--logo-ring, #8A1729)" stroke-width="12"
  />

  <!-- turbine blades -->
  <g clip-path={`url(#rim-${uid})`}>
    <circle cx="100" cy="100" r="64" fill="#8da0af" />
    <circle cx="100" cy="50" r="43" fill="#879aa9" stroke="#25384a" stroke-width="1.6" stroke-opacity="0.55" />
    <circle cx="143.3" cy="75" r="43" fill="#2a3d4f" stroke="#25384a" stroke-width="1.6" stroke-opacity="0.55" />
    <circle cx="143.3" cy="125" r="43" fill="#8598a7" stroke="#25384a" stroke-width="1.6" stroke-opacity="0.55" />
    <circle cx="100" cy="150" r="43" fill="#293c4e" stroke="#25384a" stroke-width="1.6" stroke-opacity="0.55" />
    <circle cx="56.7" cy="125" r="43" fill="#8396a6" stroke="#25384a" stroke-width="1.6" stroke-opacity="0.55" />
    <circle cx="56.7" cy="75" r="43" fill="#273a4c" stroke="#25384a" stroke-width="1.6" stroke-opacity="0.55" />
  </g>

  <!-- orbit, near side, crossing in front of the wheel -->
  <path
    d="M 194.08 104.87 A 95 35 0 0 1 5.92 104.87"
    transform="rotate(-21 100 100)"
    stroke="var(--logo-ring, #C8102E)" stroke-width="12" stroke-linecap="round"
  />

  <!-- hub -->
  <circle cx="100" cy="100" r="21" fill="#E8EBEE" />
  <circle cx="100" cy="100" r="21" stroke="#25384a" stroke-width="2.5" />
  <circle cx="100" cy="88.5" r="3.6" fill="#354859" />
  <circle cx="110.94" cy="96.45" r="3.6" fill="#354859" />
  <circle cx="106.76" cy="109.3" r="3.6" fill="#354859" />
  <circle cx="93.24" cy="109.3" r="3.6" fill="#354859" />
  <circle cx="89.06" cy="96.45" r="3.6" fill="#354859" />
</svg>
