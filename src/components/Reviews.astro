---
import { reviews, reviewsVerified, reviewsUrl, business } from '../config/business.js';
import Stars from './Stars.astro';

const { rating } = business;
---

<section id="avis" class="scroll-mt-20 border-t border-rule bg-surface py-section">
  <div class="mx-auto max-w-6xl px-5 lg:px-8">
    <div class="flex flex-col gap-8 sm:flex-row sm:items-end sm:justify-between">
      <div class="max-w-lg">
        <span class="band" data-reveal></span>
        <h2 class="mt-5 font-display text-[clamp(1.9rem,4.5vw,2.9rem)] font-extrabold" data-reveal>
          Ce qu'en disent les clients
        </h2>
      </div>

      <div class="flex shrink-0 items-center gap-5" data-reveal>
        <p
          class="font-display text-[3.5rem] font-extrabold leading-none tracking-tight tabular-nums text-ink"
          data-count={rating.value}
          data-count-decimals="1"
        >
          {rating.value.toString().replace('.', ',')}
        </p>
        <div class="border-l border-rule pl-5">
          <Stars value={rating.value} size="size-4" />
          <p class="mt-1.5 text-[0.95rem] text-steel">
            <span class="font-semibold text-ink"><span class="tabular-nums" data-count={rating.count}>{rating.count}</span> avis</span> Google
          </p>
        </div>
      </div>
    </div>

    {!reviewsVerified && (
      <p
        class="mt-10 flex items-start gap-3 border-l-4 border-amber-500 bg-amber-50 px-5 py-4 text-[0.95rem] leading-relaxed text-amber-900"
        data-placeholder-warning
      >
        <span aria-hidden="true" class="mt-0.5 font-bold">!</span>
        <span>
          <strong class="font-semibold">Contenu de démonstration.</strong> Les textes ci-dessous
          sont des gabarits de mise en page, pas de vrais avis. Ils doivent être remplacés par le
          libellé exact des avis Google avant mise en ligne — publier de faux avis est sanctionné
          (art. L121-2 du Code de la consommation).
        </span>
      </p>
    )}

    {/*
      Two columns, not four. The real reviews run from 50 to 150 words, and four
      equal columns forced the short ones into tall empty boxes beside the long
      ones. Two columns absorb the difference; `break-inside` keeps a card from
      splitting across the column break.
    */}
    <div class="mt-12 gap-6 sm:columns-2 [&>*]:mb-6" data-reveal>
      {reviews.map((review) => (
        <figure class="break-inside-avoid border-t-2 border-ink bg-surface pt-5">
          <div class="flex items-center justify-between gap-4">
            <Stars value={review.rating} size="size-[0.95rem]" />
            <span class="text-sm text-steel-light">{review.date}</span>
          </div>

          <blockquote class="mt-4 text-[1.02rem] leading-relaxed text-ink-soft">
            « {review.text} »
          </blockquote>

          <figcaption class="mt-5 flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <span class="font-display text-base font-bold text-ink">{review.author}</span>
            {review.badge && (
              <span class="border border-rule px-2 py-0.5 font-display text-[0.7rem] font-semibold uppercase tracking-[0.1em] text-steel">
                {review.badge}
              </span>
            )}
            <span class="text-sm text-steel-light">{review.meta}</span>
          </figcaption>

          <p class="label mt-2 text-steel-light">{review.highlight}</p>

          {/* An excerpt says so, and links to the full text. */}
          {review.truncated && (
            <p class="mt-3 text-sm text-steel-light">
              Extrait —{' '}
              <a
                href={reviewsUrl}
                target="_blank"
                rel="noopener"
                class="underline underline-offset-2 transition-colors hover:text-ink"
              >
                lire l'avis complet sur Google
              </a>
            </p>
          )}
        </figure>
      ))}
    </div>

    <p class="mt-4 text-[0.95rem] text-steel" data-reveal>
      <a
        href={reviewsUrl}
        target="_blank"
        rel="noopener"
        class="inline-flex min-h-11 items-center font-semibold text-crimson underline decoration-crimson/40 underline-offset-4 transition-colors hover:decoration-crimson"
      >
        Voir les {rating.count} avis sur Google
      </a>
    </p>
  </div>
</section>
